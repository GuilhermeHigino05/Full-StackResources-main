{
  "swagger": "2.0",
  "info": {
    "title": "Crud API imovel",
    "description": "Documentação da API de imóveis",
    "version": "1.0.0"
  },
  "host": "localhost:5000",
  "basePath": "/",
  "schemes": [
    "http"
  ],
  "paths": {
    "/imoveis": {
      "get": {
        "tags": [
          "Imóveis"
        ],
        "summary": "Lista todos os imóveis",
        "responses": {
          "200": {
            "description": "Lista de imóveis"
          },
          "204": {
            "description": "Nenhum imóvel cadastrado"
          },
          "500": {
            "description": "Erro interno do servidor"
          }
        }
      },
      "post": {
        "tags": [
          "Imóveis"
        ],
        "summary": "Cadastra um imóvel",
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/ImovelInput"
            }
          }
        ],
        "responses": {
          "201": {
            "description": "Imóvel cadastrado"
          },
          "400": {
            "description": "Parâmetros incorretos"
          },
          "500": {
            "description": "Erro interno do servidor"
          }
        }
      }
    }
  },
  "definitions": {
    "ImovelInput": {
      "type": "object",
      "required": [
        "description",
        "cep",
        "address",
        "neighborhood",
        "city",
        "price",
        "available"
      ],
      "properties": {
        "description": {
          "type": "string",
          "example": "Apartamento com 2 quartos"
        },
        "cep": {
          "type": "string",
          "example": "12345-678"
        },
        "address": {
          "type": "string",
          "example": "Rua Central, 100"
        },
        "neighborhood": {
          "type": "string",
          "example": "Centro"
        },
        "city": {
          "type": "string",
          "example": "São Paulo"
        },
        "price": {
          "type": "number",
          "example": 250000
        },
        "available": {
          "type": "boolean",
          "example": true
        }
      }
    }
  }
}
